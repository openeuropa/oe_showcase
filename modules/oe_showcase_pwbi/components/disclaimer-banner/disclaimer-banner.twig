{% set attributes = attributes.addClass('pwbi-disclaimer-banner') %}
{% if display_type == "pwbi" %}
  {% set attributes = attributes.addClass("pwbi-banner-overlay") %}
{% endif %}

<div {{ attributes }}>
  <div class="bg-primary text-white text-center bcl-banner">
    <div class="container">
        <div class="bcl-banner__content">
          <div class="pwbi-disclaimer-text">
            {{ banner_text }}
          </div>
          <div class="pwbi-disclaimer-accept">
            <button class="btn btn-light btn-md" type="button">{{ 'Accept'|t }}</button>
        </div>
      </div>
    </div>
  </div>
</div>
