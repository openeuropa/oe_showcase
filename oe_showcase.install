<?php

/**
 * @file
 * Install file.
 */

declare(strict_types=1);

use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\oe_bootstrap_theme\ConfigImporter;

/**
 * Implements hook_install().
 */
function oe_showcase_install(): void {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('oe_whitelabel');
  $recipes = [
    $theme_path . '/recipes/media_image_copyright',
    $theme_path . '/recipes/media_remote_video_copyright',
    $theme_path . '/recipes/media_av_portal_photo_copyright',
    $theme_path . '/recipes/media_av_portal_video_copyright',
  ];
  foreach ($recipes as $recipe_path) {
    if (is_dir($recipe_path)) {
      RecipeRunner::processRecipe(Recipe::createFromDirectory($recipe_path));
    }
  }

  ConfigImporter::importMultiple('profile', 'oe_showcase', '/config/post_updates/00060_media_copyright', [
    'core.entity_view_display.media.image.oe_w_pattern_gallery_item',
    'core.entity_view_display.media.remote_video.oe_w_pattern_gallery_item',
    'core.entity_view_display.media.av_portal_photo.oe_w_pattern_gallery_item',
    'core.entity_view_display.media.av_portal_video.oe_w_pattern_gallery_item',
  ]);

  oe_showcase_apply_media_copyright_to_all_bundles();
}

/**
 * Applies a demo default copyright to existing media items.
 */
function oe_showcase_apply_media_copyright_to_all_bundles(): void {
  $default_copyright = 'Copyright text for demo';
  $field_storage = FieldStorageConfig::loadByName('media', 'field_media_copyright');
  if ($field_storage === NULL) {
    return;
  }

  $bundles = [
    'image',
    'remote_video',
    'av_portal_photo',
    'av_portal_video',
  ];
  foreach ($bundles as $bundle) {
    $field_config = FieldConfig::loadByName('media', $bundle, 'field_media_copyright');
    if ($field_config !== NULL && empty($field_config->get('default_value'))) {
      $field_config->set('default_value', [
        ['value' => $default_copyright],
      ]);
      $field_config->save();
    }
  }

  $media_storage = \Drupal::entityTypeManager()->getStorage('media');
  $media_ids = \Drupal::entityQuery('media')->accessCheck(FALSE)->execute();
  foreach (array_chunk($media_ids, 50) as $chunk) {
    $media_items = $media_storage->loadMultiple($chunk);
    foreach ($media_items as $media) {
      if ($media->hasField('field_media_copyright') && $media->get('field_media_copyright')->isEmpty()) {
        $media->set('field_media_copyright', $default_copyright);
        $media->save();
      }
    }
  }
}

/**
 * Implements hook_post_updates_alter().
 */
function oe_showcase_post_updates_alter(&$updates) {
  // We need to move the profile post updates to the bottom, so they run always
  // after all the updates from dependencies have been executed.
  foreach ($updates as $key => $update) {
    if (str_starts_with($update, 'oe_showcase_')) {
      unset($updates[$key]);
      $updates[] = $update;
    }
  }
}
