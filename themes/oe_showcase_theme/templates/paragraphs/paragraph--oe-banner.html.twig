{#
/**
 * @file
 * Theme override to display the 'banner' type paragraph with optional copyright.
 *
 * @see ./modules/contrib/paragraphs/templates/paragraph.html.twig
 */
#}
{% if url %}
  {% set _call_to_action = {
    'label': label,
    'path': url,
    'attributes': create_attribute({
      'class': [
        'btn',
        variant == 'primary' ? 'btn-light' : 'btn-primary',
      ],
    }),
    'icon': {
      'name': 'chevron-right',
      'size': 'fluid',
      'path': bcl_icon_path,
    },
  } %}
{% endif %}
{% set _hero = 'hero' in pattern %}
{% set _shade = 'shade' in variant %}

{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
  ]
%}
{% set attributes = attributes.addClass(classes) %}

{% set copyright_value = '' %}
{% set has_media = false %}
{% if not paragraph.get('field_oe_media').isEmpty() %}
  {% set media_entity = paragraph.get('field_oe_media').entity %}
  {% if media_entity %}
    {% set has_media = true %}
    {% if media_entity.hasField('field_media_copyright') %}
      {% set copyright_value = media_entity.field_media_copyright.value ?: 'Copyright text for demo' %}
    {% endif %}
  {% endif %}
{% endif %}

{% set banner_params = {
  'variant': variant,
  'title': title,
  'description': description,
  'call_to_action': _call_to_action,
  'image': image.src,
  'hero': _hero,
  'shade': _shade,
  'full_width': full_width,
  'centered': centered,
} %}

{% set wrapper_attributes = attributes %}
{% set banner_attributes = create_attribute(attributes.toArray()|without('id')) %}

{% set banner_markup %}
  {{ pattern('banner', banner_params|merge({
    'attributes': banner_attributes,
  })) }}
{% endset %}

{% if copyright_value and has_media %}
  {{ pattern('media_container', {
    media: banner_markup,
    copyright: {
      content: copyright_value,
    },
    tag: 'div',
    attributes: wrapper_attributes,
  }) }}
{% else %}
  {{ banner_markup }}
{% endif %}
