{#
/**
 * @file
 * Theme override to display AV Portal video media with optional copyright overlay.
 */
#}
{% set copyright_value = media.hasField('field_media_copyright') ? media.field_media_copyright.value : '' %}
{% set media_output = content.oe_media_avportal_video %}

<div{{ attributes }}>
  {{ title_suffix.contextual_links }}
  {% if media_output is not empty %}
    {% if copyright_value %}
      {{ pattern('media_container', {
        media: media_output,
        copyright: {
          content: copyright_value,
        },
      }) }}
    {% else %}
      {{ media_output }}
    {% endif %}
  {% endif %}
  {{ content|without('oe_media_avportal_video', 'field_media_copyright') }}
</div>
