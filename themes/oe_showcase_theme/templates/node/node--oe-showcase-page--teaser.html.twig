{#
/**
 * @file
 * Search result template.
 */
#}
{% set _title %}
  <a class="standalone" href="{{ url }}">{{ label }}</a>
{% endset %}
{{ pattern('card', {
  variant: 'search',
  title: _title,
  title_tag: 'h2',
  text: content.body,
  meta: [
    node.getCreatedTime|format_date('oe_showcase_page_date'),
  ],
}) }}
